{
  "$schema": "https://raw.githubusercontent.com/crabnebula-dev/cargo-packager/main/crates/packager/schema.json",
  "name": "soliddraft-app",
  "productName": "SolidDraft",
  "identifier": "io.github.bohnbawerick.soliddraft",
  "publisher": "SolidDraft contributors",
  "version": "0.1.0",
  "description": "Parametric CAD with a local geometry kernel",
  "homepage": "https://github.com/BohnBawerick/soliddraft",
  "authors": ["SolidDraft contributors"],
  "licenseFile": "../LICENSE",
  "category": "GraphicsAndDesign",
  "binaries": [{"path": "soliddraft-app", "main": true}],
  "icons": ["icon.png"],
  "resources": ["../LICENSE", "../NOTICE"],
  "fileAssociations": [
    {"extensions": ["dwprt"], "name": "SolidDraft part", "role": "editor"},
    {"extensions": ["dwasm"], "name": "SolidDraft assembly", "role": "editor"},
    {"extensions": ["dwdrw"], "name": "SolidDraft drawing", "role": "editor"}
  ],
  "macos": {"minimumSystemVersion": "11.0"},
  "windows": {"allowDowngrades": false}
}
